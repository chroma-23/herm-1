


<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.5, user-scalable=yes">
  <title>Mount Hermon Schools | Empowering Minds. Shaping Future.</title>
  <!-- Font Awesome 6 (free) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    /* ---------- RESET & GLOBAL ---------- */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    :root {
      --primary-blue: #002b5c;    /* Deep Navy Blue from flyer */
      --primary-light: #004080;
      --accent-red: #b81d24;      /* Crimson Red from flyer */
      --accent-yellow: #ffc107;   /* Golden Yellow from flyer */
      --accent-yellow-hover: #e0a800;
      --bg-light: #f4f7f9;
      --text-dark: #1e2b37;
      --text-muted: #556b7c;
      --white: #ffffff;
      --shadow-sm: 0 4px 12px rgba(0,0,0,0.05);
      --shadow-md: 0 10px 25px rgba(0,0,0,0.1);
      --radius: 12px;
      --radius-lg: 24px;
    }

    body {
      background-color: var(--bg-light);
      color: var(--text-dark);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    h1, h2, h3, h4 {
      font-weight: 700;
      line-height: 1.2;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    button, .btn {
      cursor: pointer;
      border: none;
      font-weight: 600;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .container {
      width: 100%;
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 20px;
    }

    /* ---------- BUTTONS ---------- */
    .btn-primary {
      background: var(--accent-yellow);
      color: var(--primary-blue);
      padding: 14px 32px;
      border-radius: 50px;
      font-size: 1.1rem;
      box-shadow: 0 4px 15px rgba(255, 193, 7, 0.3);
      border: 2px solid transparent;
    }

    .btn-primary:hover {
      background: var(--accent-yellow-hover);
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(255, 193, 7, 0.4);
    }

    .btn-outline {
      background: transparent;
      border: 2px solid var(--white);
      color: var(--white);
      padding: 12px 28px;
      border-radius: 50px;
      font-size: 1rem;
    }

    .btn-outline:hover {
      background: var(--white);
      color: var(--primary-blue);
    }

    /* ---------- HEADER / NAV ---------- */
    header {
      background: var(--primary-blue);
      color: var(--white);
      padding: 12px 0;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .nav-container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 1.5rem;
      font-weight: 800;
    }

    .logo i {
      color: var(--accent-yellow);
      font-size: 2rem;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 24px;
      list-style: none;
    }

    .nav-links a {
      font-weight: 600;
      font-size: 0.95rem;
      color: rgba(255,255,255,0.9);
      transition: color 0.2s;
    }

    .nav-links a:hover {
      color: var(--accent-yellow);
    }

    .enroll-btn-header {
      background: var(--accent-red);
      color: var(--white);
      padding: 10px 24px;
      border-radius: 50px;
      font-weight: 700;
      font-size: 0.95rem;
      border: none;
    }

    .enroll-btn-header:hover {
      background: #9a161c;
      transform: scale(1.02);
    }

    .menu-toggle {
      display: none;
      font-size: 1.8rem;
      background: transparent;
      color: white;
    }

    /* ---------- HERO ---------- */
    .hero {
      background: linear-gradient(135deg, rgba(0, 43, 92, 0.95) 0%, rgba(0, 64, 128, 0.9) 100%), url('https://images.unsplash.com/photo-1580582932707-520aed937b7b?q=80&w=1600&auto=format&fit=crop') center/cover;
      color: white;
      padding: 80px 0 100px;
      text-align: center;
    }

    .hero h1 {
      font-size: clamp(2rem, 5vw, 3.5rem);
      margin-bottom: 10px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .hero h2 {
      font-size: clamp(1.2rem, 3vw, 1.8rem);
      color: var(--accent-yellow);
      font-style: italic;
      margin-bottom: 24px;
      font-weight: 500;
    }

    .hero p {
      font-size: 1.1rem;
      max-width: 650px;
      margin: 0 auto 32px;
      opacity: 0.9;
    }

    .hero-badges {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 15px;
      margin-top: 40px;
    }

    .hero-badge {
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(5px);
      padding: 8px 16px;
      border-radius: 50px;
      border: 1px solid rgba(255,255,255,0.2);
      font-size: 0.9rem;
      font-weight: 600;
    }

    .hero-badge i {
      color: var(--accent-yellow);
      margin-right: 6px;
    }

    /* ---------- SECTION TITLES ---------- */
    .section {
      padding: 70px 0;
    }

    .section-header {
      text-align: center;
      max-width: 700px;
      margin: 0 auto 50px;
    }

    .section-header h2 {
      font-size: 2.2rem;
      color: var(--primary-blue);
      margin-bottom: 12px;
      position: relative;
      display: inline-block;
    }

    .section-header h2::after {
      content: '';
      position: absolute;
      bottom: -8px;
      left: 50%;
      transform: translateX(-50%);
      width: 60px;
      height: 4px;
      background: var(--accent-red);
      border-radius: 2px;
    }

    .section-header p {
      font-size: 1.05rem;
      color: var(--text-muted);
      margin-top: 15px;
    }

    /* ---------- ACADEMICS (PROGRAMS) ---------- */
    .programs-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 24px;
    }

    .program-card {
      background: var(--white);
      border-radius: var(--radius);
      padding: 30px 24px;
      box-shadow: var(--shadow-sm);
      border-top: 5px solid var(--primary-blue);
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .program-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-md);
    }

    .program-icon {
      width: 60px;
      height: 60px;
      background: rgba(0, 43, 92, 0.05);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.8rem;
      color: var(--primary-blue);
      margin-bottom: 20px;
    }

    .program-card:nth-child(2) .program-icon { color: var(--accent-red); background: rgba(184, 29, 36, 0.05); }
    .program-card:nth-child(3) .program-icon { color: var(--accent-yellow-hover); background: rgba(255, 193, 7, 0.1); }
    .program-card:nth-child(4) .program-icon { color: var(--primary-blue); background: rgba(0, 43, 92, 0.05); }

    .program-card h3 {
      color: var(--primary-blue);
      font-size: 1.3rem;
      margin-bottom: 8px;
    }

    .program-card p {
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    /* ---------- WHY CHOOSE US & TRANSPORT ---------- */
    .split-section {
      background: var(--white);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
      display: flex;
      flex-wrap: wrap;
    }

    .split-half {
      flex: 1 1 400px;
      padding: 40px;
    }

    .split-half.blue {
      background: var(--primary-blue);
      color: white;
    }

    .split-half.red {
      background: var(--accent-red);
      color: white;
    }

    .split-half h3 {
      font-size: 1.6rem;
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .split-half h3 i {
      color: var(--accent-yellow);
    }

    .check-list {
      list-style: none;
    }

    .check-list li {
      margin-bottom: 15px;
      display: flex;
      align-items: flex-start;
      gap: 12px;
      font-size: 1rem;
    }

    .check-list li i {
      color: var(--accent-yellow);
      margin-top: 4px;
    }

    /* ---------- ADMISSIONS BANNER ---------- */
    .admissions-banner {
      background: var(--accent-red);
      color: white;
      border-radius: var(--radius);
      padding: 40px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 30px;
      margin: 40px 0;
      box-shadow: var(--shadow-md);
      position: relative;
      overflow: hidden;
    }

    .admissions-banner::before {
      content: '\f19d';
      font-family: 'Font Awesome 6 Free';
      font-weight: 900;
      position: absolute;
      font-size: 150px;
      right: -20px;
      bottom: -20px;
      opacity: 0.1;
    }

    .admissions-banner h2 {
      font-size: 2rem;
      margin-bottom: 8px;
    }

    .admissions-banner p {
      font-size: 1.1rem;
      opacity: 0.9;
    }

    .contact-boxes {
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
      margin-top: 20px;
      z-index: 1;
    }

    .contact-box {
      background: rgba(255,255,255,0.15);
      padding: 10px 20px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 600;
      font-size: 1.1rem;
    }

    .contact-box i {
      font-size: 1.2rem;
      color: var(--accent-yellow);
    }

    /* ---------- LOCATION ---------- */
    .location-section {
      display: flex;
      flex-wrap: wrap;
      gap: 40px;
      align-items: center;
    }

    .location-text {
      flex: 1 1 400px;
    }

    .location-text h2 {
      color: var(--primary-blue);
      font-size: 2rem;
      margin-bottom: 20px;
    }

    .location-text p {
      font-size: 1.05rem;
      color: var(--text-muted);
      margin-bottom: 20px;
      line-height: 1.8;
    }

    .location-image {
      flex: 1 1 300px;
      background: var(--white);
      padding: 30px;
      border-radius: var(--radius);
      box-shadow: var(--shadow-sm);
      text-align: center;
      border: 1px solid rgba(0,0,0,0.05);
    }

    .location-image i {
      font-size: 5rem;
      color: var(--primary-blue);
      margin-bottom: 20px;
    }

    /* ---------- FOOTER ---------- */
    footer {
      background: #001a38;
      color: rgba(255,255,255,0.8);
      padding: 60px 0 24px;
      margin-top: 60px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 40px;
      margin-bottom: 40px;
    }

    .footer-col h4 {
      color: var(--white);
      font-size: 1.1rem;
      margin-bottom: 20px;
      position: relative;
    }

    .footer-col h4::after {
      content: '';
      position: absolute;
      bottom: -6px;
      left: 0;
      width: 30px;
      height: 3px;
      background: var(--accent-red);
    }

    .footer-col ul {
      list-style: none;
    }

    .footer-col ul li {
      margin-bottom: 12px;
      font-size: 0.95rem;
    }

    .footer-col a:hover {
      color: var(--accent-yellow);
    }

    .copyright {
      border-top: 1px solid rgba(255,255,255,0.1);
      padding-top: 24px;
      text-align: center;
      font-size: 0.9rem;
      color: rgba(255,255,255,0.6);
    }

    /* ---------- RESPONSIVE ---------- */
    @media (max-width: 860px) {
      .nav-links {
        display: none;
        width: 100%;
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
        padding: 20px 0 10px;
      }
      .nav-links.active { display: flex; }
      .menu-toggle { display: block; }
      .enroll-btn-header { width: 100%; text-align: center; }
      .hero { padding: 60px 0 80px; }
      .admissions-banner { text-align: center; justify-content: center; }
      .contact-boxes { justify-content: center; }
      .split-half { padding: 30px 20px; }
    }

    @media (max-width: 480px) {
      .hero h1 { font-size: 1.8rem; }
      .hero-actions { flex-direction: column; width: 100%; }
      .btn-primary, .btn-outline { width: 100%; }
      .section-header h2 { font-size: 1.8rem; }
    }
  </style>
</head>
<body>

  <!-- ========== HEADER ========== -->
  <header>
    <div class="container nav-container">
      <div class="logo">
        <i class="fas fa-school"></i>
        <div style="line-height: 1.1;">
          <span style="display: block; font-size: 1.2rem;">Mount Hermon</span>
          <span style="display: block; font-size: 0.8rem; color: var(--accent-yellow); letter-spacing: 1px;">SCHOOLS - MWINGI</span>
        </div>
      </div>
      <button class="menu-toggle" id="menuToggle" aria-label="Menu">
        <i class="fas fa-bars"></i>
      </button>
      <ul class="nav-links" id="navLinks">
        <li><a href="#home">Home</a></li>
        <li><a href="#academics">Academics</a></li>
        <li><a href="#why-us">Why Us</a></li>
        <li><a href="#location">Location</a></li>
        <li><a href="#contact">Contact</a></li>
        <li><button class="enroll-btn-header" id="enrollHeader"><i class="fas fa-pen-fancy"></i> Apply Now</button></li>
      </ul>
    </div>
  </header>

  <!-- ========== HERO ========== -->
  <section class="hero" id="home">
    <div class="container">
      <h1>Mount Hermon Schools</h1>
      <h2>Empowering Minds. Shaping Future.</h2>
      <p>Learn, not for school but for life. We provide a safe, nurturing, and conducive learning environment for holistic development from Play Group to Junior Secondary.</p>
      
      <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
        <button class="btn-primary" id="heroEnrollBtn"><i class="fas fa-user-graduate"></i> Admissions Open 2027</button>
        <button class="btn-outline" id="heroCallBtn"><i class="fas fa-phone-alt"></i> Call: 0720 225 986</button>
      </div>

      <div class="hero-badges">
        <div class="hero-badge"><i class="fas fa-check-circle"></i> Quality Education</div>
        <div class="hero-badge"><i class="fas fa-shield-alt"></i> Safe Environment</div>
        <div class="hero-badge"><i class="fas fa-building"></i> Modern Facilities</div>
        <div class="hero-badge"><i class="fas fa-users"></i> Holistic Development</div>
      </div>
    </div>
  </section>

  <!-- ========== ACADEMICS / PROGRAMS ========== -->
  <section class="section" id="academics">
    <div class="container">
      <div class="section-header">
        <h2>Our Comprehensive Programs</h2>
        <p>We are admitting children into the following levels for the 2027 Academic Year.</p>
      </div>
      <div class="programs-grid">
        <div class="program-card">
          <div class="program-icon"><i class="fas fa-baby"></i></div>
          <h3>Pre-Primary & Baby Class</h3>
          <p>Play Group, Pre-primary 1 & 2. A foundation of discovery and growth in a caring environment.</p>
        </div>
        <div class="program-card">
          <div class="program-icon"><i class="fas fa-child"></i></div>
          <h3>Lower Primary</h3>
          <p>Grades 1 to 3. Building a strong foundation with experienced teachers and a max class size of 25 pupils.</p>
        </div>
        <div class="program-card">
          <div class="program-icon"><i class="fas fa-book-reader"></i></div>
          <h3>Upper Primary</h3>
          <p>Grades 4 to 6. Explore, learn, and excel in a conducive environment away from urban noise.</p>
        </div>
        <div class="program-card">
          <div class="program-icon"><i class="fas fa-graduation-cap"></i></div>
          <h3>Junior Secondary</h3>
          <p>Grades 7 to 9. Preparing for a greater tomorrow with quality education and boarding facilities available.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== WHY CHOOSE US & TRANSPORT ========== -->
  <section class="section" id="why-us" style="padding-top: 0;">
    <div class="container">
      <div class="split-section">
        <!-- Left Side: Why Choose Us -->
        <div class="split-half blue">
          <h3><i class="fas fa-star"></i> Why Choose Mount Hermon?</h3>
          <ul class="check-list">
            <li><i class="fas fa-check-circle"></i> <strong>Affordable Fees:</strong> Low charges with favorable payment terms.</li>
            <li><i class="fas fa-check-circle"></i> <strong>Boarding Facilities:</strong> Mattress, basin, and bucket provided. Washing clothes assistance for Gr 3-5.</li>
            <li><i class="fas fa-check-circle"></i> <strong>Experienced Staff:</strong> Trained and committed teachers who care for every child.</li>
            <li><i class="fas fa-check-circle"></i> <strong>Optimal Class Sizes:</strong> Maximum of 25 pupils per class (never more than 30).</li>
            <li><i class="fas fa-check-circle"></i> <strong>School Uniforms:</strong> Available at affordable prices.</li>
            <li><i class="fas fa-check-circle"></i> <strong>Play Equipment:</strong> Adequate playground and games equipment provided.</li>
          </ul>
        </div>
        
        <!-- Right Side: Transport -->
        <div class="split-half red">
          <h3><i class="fas fa-bus"></i> School Transport Available</h3>
          <p style="margin-bottom: 20px; opacity: 0.9;">We provide safe transport at very affordable costs from surrounding areas including:</p>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
            <ul class="check-list" style="margin-bottom: 0;">
              <li><i class="fas fa-map-marker-alt"></i> Katalawa</li>
              <li><i class="fas fa-map-marker-alt"></i> Mukatano</li>
              <li><i class="fas fa-map-marker-alt"></i> Mululu</li>
              <li><i class="fas fa-map-marker-alt"></i> Mwingi Town</li>
              <li><i class="fas fa-map-marker-alt"></i> Musukini</li>
            </ul>
            <ul class="check-list" style="margin-bottom: 0;">
              <li><i class="fas fa-map-marker-alt"></i> Kwa Suvu</li>
              <li><i class="fas fa-map-marker-alt"></i> Kiseveni</li>
              <li><i class="fas fa-map-marker-alt"></i> Mboru Junction</li>
              <li><i class="fas fa-map-marker-alt"></i> Mathyakani</li>
              <li><i class="fas fa-map-marker-alt"></i> Malembwani</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== ADMISSIONS CTA ========== -->
  <div class="container">
    <div class="admissions-banner" id="contact">
      <div>
        <h2>Bring Your Child to Mount Hermon</h2>
        <p>Book a place for your child now. Your child deserves nothing but the best.</p>
        <div class="contact-boxes">
          <div class="contact-box"><i class="fas fa-phone-alt"></i> 0720 225 986</div>
          <div class="contact-box"><i class="fas fa-phone-alt"></i> 0733 291 507</div>
          <div class="contact-box"><i class="fas fa-phone-alt"></i> 0715 273 341</div>
        </div>
      </div>
      <button class="btn-primary" id="bannerEnrollBtn" style="padding: 16px 36px; font-size: 1.2rem;"><i class="fas fa-file-signature"></i> Enroll Now</button>
    </div>
  </div>

  <!-- ========== LOCATION ========== -->
  <section class="section" id="location">
    <div class="container location-section">
      <div class="location-text">
        <h2>Easy Access & Convenient Location</h2>
        <p>The school is situated just <strong>6km from Mwingi Town</strong> on the road to Nzeluni/Mumbuni. The road is tarmacked up to the school and beyond.</p>
        <p><strong>Route Guide:</strong> From Mwingi Town, pass Total Petrol Station and Nzeluni Matatu Stage. Continue straight for about 6km. You will see the school on your left.</p>
        <p><i class="fas fa-clock" style="color: var(--accent-red);"></i> <strong>Visiting Hours:</strong> Monday – Friday, 9:00am – 4:00pm.</p>
        <p><i class="fas fa-envelope" style="color: var(--accent-red);"></i> <strong>P.O. Box 323-90400, Mwingi</strong></p>
      </div>
      <div class="location-image">
        <i class="fas fa-map-signs"></i>
        <h3 style="color: var(--primary-blue); margin-bottom: 10px;">Find Us</h3>
        <p style="color: var(--text-muted); font-size: 0.95rem;">Mwingi - Nzeluni Road, Mwingi, Kitui County, Kenya.</p>
      </div>
    </div>
  </section>

  <!-- ========== FOOTER ========== -->
  <footer>
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col">
          <div class="logo" style="margin-bottom: 16px;">
            <i class="fas fa-school" style="color: var(--accent-yellow);"></i>
            <span style="color: white; font-size: 1.4rem;">Mount Hermon</span>
          </div>
          <p style="font-size: 0.95rem; margin-top: 8px;">P.O. Box 323-90400, Mwingi.<br>"Learn, not for school but for life."</p>
        </div>
        <div class="footer-col">
          <h4>Quick Links</h4>
          <ul>
            <li><a href="#academics">Our Programs</a></li>
            <li><a href="#why-us">Why Choose Us</a></li>
            <li><a href="#location">Location & Transport</a></li>
            <li><a href="#contact">Admissions</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Contact Us</h4>
          <ul>
            <li><i class="fas fa-phone-alt" style="color: var(--accent-red); margin-right: 8px;"></i> 0720 225 986</li>
            <li><i class="fas fa-phone-alt" style="color: var(--accent-red); margin-right: 8px;"></i> 0733 291 507</li>
            <li><i class="fas fa-phone-alt" style="color: var(--accent-red); margin-right: 8px;"></i> 0715 273 341</li>
            <li><i class="fas fa-clock" style="color: var(--accent-red); margin-right: 8px;"></i> Mon–Fri, 8am–4pm</li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Our Motto</h4>
