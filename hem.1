  <!-- ========== JAVASCRIPT ========== -->
  <script>
    (function() {
      // ---- Mobile menu toggle ----
      const menuToggle = document.getElementById('menuToggle');
      const navLinks = document.getElementById('navLinks');

      if (menuToggle && navLinks) {
        menuToggle.addEventListener('click', function(e) {
          e.preventDefault();
          navLinks.classList.toggle('active');
          const icon = menuToggle.querySelector('i');
          if (navLinks.classList.contains('active')) {
            icon.classList.remove('fa-bars');
            icon.classList.add('fa-times');
          } else {
            icon.classList.remove('fa-times');
            icon.classList.add('fa-bars');
          }
        });
      }

      // Close menu on link click
      document.querySelectorAll('.nav-links a').forEach(link => {
        link.addEventListener('click', () => {
          if (navLinks.classList.contains('active')) {
            navLinks.classList.remove('active');
            const icon = menuToggle.querySelector('i');
            icon.classList.remove('fa-times');
            icon.classList.add('fa-bars');
          }
        });
      });

      // ---- Enrollment Demo Alerts ----
      function handleEnrollment(source) {
        alert(`🎓 Thank you for your interest in Mount Hermon Schools!\n\nPlease call us directly to complete your application:\n📞 0720 225 986\n📞 0733 291 507\n📞 0715 273 341\n\n(Visiting hours: Mon-Fri, 9am - 4pm)`);
      }

      document.getElementById('enrollHeader').addEventListener('click', (e) => { e.preventDefault(); handleEnrollment('header'); });
      document.getElementById('heroEnrollBtn').addEventListener('click', () => handleEnrollment('hero'));
      document.getElementById('bannerEnrollBtn').addEventListener('click', () => handleEnrollment('banner'));

      // ---- Call Button ----
      document.getElementById('heroCallBtn').addEventListener('click', () => {
        alert('📞 Please dial: 0720 225 986, 0733 291 507, or 0715 273 341');
      });

      // ---- Smooth scrolling for anchor links ----
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          const targetId = this.getAttribute('href');
          if (targetId === '#') return;
          
          const targetElement = document.querySelector(targetId);
          if (targetElement) {
            e.preventDefault();
            targetElement.scrollIntoView({
              behavior: 'smooth',
              block: 'start'
            });
          }
        });
      });

    })();
  </script>
</body>
</html>
